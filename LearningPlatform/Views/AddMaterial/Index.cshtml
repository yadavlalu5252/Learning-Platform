<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>

<script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>


<script>

    // =====================================================
    // DATATABLE
    // =====================================================

    $(document).ready(function() {

        $('#materialTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true
        });

    });


    // =====================================================
    // FILTER SUB COURSES
    // =====================================================

    function filterSubCourses() {

        var master =
            document.getElementById("MasterCourseId");

        var sub =
            document.getElementById("SubCourseId");

        if (!master || !sub) {
            return;
        }

        var masterId = master.value;

        for (var i = 0; i < sub.options.length; i++) {

            var option = sub.options[i];

            if (option.value === "") {

                option.hidden = false;

            }
            else {

                option.hidden =
                    option.getAttribute("data-master")
                    !== masterId;

            }
        }

        sub.disabled = masterId === "";
    }


    // =====================================================
    // FILTER TOPICS
    // =====================================================

    function filterTopics() {

        var master =
            document.getElementById("MasterCourseId");

        var sub =
            document.getElementById("SubCourseId");

        var topic =
            document.getElementById("TopicId");

        if (!master || !sub || !topic) {
            return;
        }

        var masterId = master.value;
        var subId = sub.value;

        for (var i = 0; i < topic.options.length; i++) {

            var option = topic.options[i];

            if (option.value === "") {

                option.hidden = false;

            }
            else {

                var optionMaster =
                    option.getAttribute("data-master");

                var optionSub =
                    option.getAttribute("data-sub");

                option.hidden =
                    optionMaster !== masterId ||
                    optionSub !== subId;
            }
        }

        topic.disabled = subId === "";
    }


    // =====================================================
    // PREPARE ADD MATERIAL
    // =====================================================

    function prepareAddMaterial() {

        var form =
            document.getElementById("materialForm");

        if (!form) {
            return;
        }

        var title =
            document.getElementById("materialModalTitle");

        var submitButton =
            document.getElementById("materialSubmitButton");


        // IMPORTANT:
        // Change form back to ADD action

        form.action =
            '@Url.Action("AddMaterial", "AddMaterial")';


        // IMPORTANT:
        // Remove edit id

        var editId =
            document.getElementById("editMaterialId");

        if (editId) {
            editId.remove();
        }


        // =================================================
        // CLEAR TEXT INPUTS
        // =================================================

        form.querySelectorAll(
            'input[type="text"]'
        ).forEach(function(input) {

            input.value = "";

        });


        // =================================================
        // CLEAR FILE
        // =================================================

        form.querySelectorAll(
            'input[type="file"]'
        ).forEach(function(input) {

            input.value = "";

        });


        // =================================================
        // RESET COURSE DROPDOWNS
        // =================================================

        var master =
            document.getElementById("MasterCourseId");

        var sub =
            document.getElementById("SubCourseId");

        var topic =
            document.getElementById("TopicId");

        var status =
            document.getElementById("Status");


        if (master) {
            master.value = "";
        }

        if (sub) {
            sub.value = "";
        }

        if (topic) {
            topic.value = "";
        }

        if (status) {
            status.value = "Active";
        }


        // =================================================
        // RESET MCQ ANSWERS
        // =================================================

        form.querySelectorAll(
            'select[name$="Answer"]'
        ).forEach(function(select) {

            select.value = "";

        });


        // =================================================
        // CHANGE TITLE
        // =================================================

        if (title) {

            title.textContent =
                "Add Material for Learning Platform";

        }


        // =================================================
        // CHANGE BUTTON
        // =================================================

        if (submitButton) {

            submitButton.textContent =
                "Add Material";

        }


        filterSubCourses();
        filterTopics();
    }


    // =====================================================
    // PAGE LOAD
    // =====================================================

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            filterSubCourses();
            filterTopics();


            var isEdit =
                    @isEdit.ToString().ToLower();


            // =================================================
            // OPEN EDIT MODAL AUTOMATICALLY
            // =================================================

            if (isEdit) {

                var modalElement =
                    document.getElementById(
                        "materialModal"
                    );

                var modal =
                    bootstrap.Modal.getOrCreateInstance(
                        modalElement
                    );

                modal.show();

            }


            // =================================================
            // OPEN ADD MODAL AFTER VALIDATION ERROR
            // =================================================

            var openAdd =
                    @openAdd.ToString().ToLower();


            if (openAdd && !isEdit) {

                var modalElement =
                    document.getElementById(
                        "materialModal"
                    );

                var modal =
                    bootstrap.Modal.getOrCreateInstance(
                        modalElement
                    );

                modal.show();

            }

        }
    );


    // =====================================================
    // MASTER COURSE CHANGE
    // =====================================================

    document.addEventListener(
        "change",
        function(event) {

            if (event.target.id === "MasterCourseId") {

                var sub =
                    document.getElementById(
                        "SubCourseId"
                    );

                var topic =
                    document.getElementById(
                        "TopicId"
                    );

                if (sub) {
                    sub.value = "";
                }

                if (topic) {
                    topic.value = "";
                }

                filterSubCourses();

                if (topic) {
                    topic.disabled = true;
                }
            }


            // =================================================
            // SUB COURSE CHANGE
            // =================================================

            if (event.target.id === "SubCourseId") {

                var topic =
                    document.getElementById(
                        "TopicId"
                    );

                if (topic) {
                    topic.value = "";
                }

                filterTopics();

            }

        }
    );


    // =====================================================
    // VIEW MCQ
    // =====================================================

    function showMCQ(id) {

        document
            .querySelectorAll(".mcq-data")
            .forEach(function(item) {

                item.style.display = "none";

            });


        var selected =
            document.getElementById(
                "mcq-" + id
            );


        if (selected) {

            selected.style.display =
                "block";

        }

    }


    // =====================================================
    // RESET MODAL WHEN CLOSED
    // =====================================================

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            var materialModal =
                document.getElementById(
                    "materialModal"
                );

            if (!materialModal) {
                return;
            }


            materialModal.addEventListener(
                "hidden.bs.modal",
                function() {

                    /*
                     * If the page is currently an edit page,
                     * do not destroy the edit data.
                     *
                     * When user clicks + Add Material,
                     * prepareAddMaterial() handles the reset.
                     */

                }
            );

        }
    );

</script>

