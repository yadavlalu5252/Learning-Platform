@model List<LearningPlatform.Models.AddMaterial>

@{
    ViewData["Title"] = "Add Material";

    var editMaterial =
        ViewBag.EditMaterial as LearningPlatform.Models.AddMaterial;

    bool isEdit = editMaterial != null;

    bool openAdd =
        ViewBag.OpenAddModal != null &&
        (bool)ViewBag.OpenAddModal;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

<link href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.css" rel="stylesheet" />

<style>

    body {
        background: #f8f9fa;
    }

    .page-container {
        max-width: 1280px;
        margin: 40px auto;
    }

    .page-title {
        font-weight: 700;
    }

    .material-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
    }

    .table th {
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* =====================================================
           MAIN MATERIAL MODAL
           ===================================================== */

    #materialModal {
        overflow: hidden !important;
    }

        #materialModal .modal-dialog {
            width: calc(100% - 40px);
            max-width: 1150px;
            height: calc(100vh - 40px);
            margin: 20px auto;
        }

        #materialModal .modal-content {
            height: 100%;
            max-height: 100%;
            border: none;
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        #materialModal .modal-header {
            flex: 0 0 auto;
            background: #fff;
            z-index: 2;
        }

        #materialModal form {
            min-height: 0;
            height: 100%;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
        }

        #materialModal .material-modal-body {
            min-height: 0;
            flex: 1 1 auto;
            overflow-y: auto !important;
            overflow-x: hidden;
            padding: 28px;
            background: #fff;
            -webkit-overflow-scrolling: touch;
        }

        #materialModal .modal-footer {
            flex: 0 0 auto;
            background: #fff;
            z-index: 2;
        }

        #materialModal .material-modal-body::-webkit-scrollbar {
            width: 9px;
        }

        #materialModal .material-modal-body::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        #materialModal .material-modal-body::-webkit-scrollbar-thumb {
            background: #bdbdbd;
            border-radius: 10px;
        }

            #materialModal .material-modal-body::-webkit-scrollbar-thumb:hover {
                background: #888;
            }

    /* =====================================================
           FORM SECTIONS
           ===================================================== */

    .form-section {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 22px;
        background: #fff;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 22px;
    }

    /* =====================================================
           MCQ
           ===================================================== */

    .mcq-card {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .mcq-header {
        background: #0d6efd;
        color: white;
        padding: 13px 18px;
        font-size: 18px;
        font-weight: 700;
    }

    .mcq-body {
        padding: 22px;
    }

    /* 
           VIEW MCQ
          */

    #viewMcqModal .modal-body {
        max-height: calc(100vh - 160px);
        overflow-y: auto;
    }

    .view-mcq-question {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        margin-bottom: 18px;
        overflow: hidden;
    }

    .view-mcq-header {
        background: #0d6efd;
        color: white;
        padding: 12px 16px;
        font-weight: 700;
    }

    .view-mcq-body {
        padding: 18px;
    }

    .option-box {
        border: 1px solid #dee2e6;
        border-radius: 7px;
        padding: 10px 12px;
        margin-bottom: 8px;
    }

    .correct-option {
        background: #d1e7dd;
        border-color: #198754;
        font-weight: 600;
    }

    .status-section {
        margin-bottom: 22px;
    }

</style>


<div class="container page-container">

    <!-- 
         HEADER
         -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="page-title mb-1">
                Add Material
            </h1>

            <p class="text-muted mb-0">
                Manage assignments and MCQ materials
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#materialModal"
                onclick="prepareAddMaterial()">

            + Add Material

        </button>

    </div>


    <!-- 
         MESSAGE
         -->
    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["msg"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================================
         TABLE
         ===================================================== -->

    <div class="card shadow-sm material-card">

        <div class="card-body">

            <div class="table-responsive">

                <table id="materialTable"
                       class="table table-bordered table-striped align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Id</th>
                            <th>Master Course</th>
                            <th>Sub Course</th>
                            <th>Topic Name</th>
                            <th>Assignment</th>
                            <th>MCQ</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Created By</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var material in Model)
                        {
                            <tr>

                                <td>
                                    @material.MaterialId
                                </td>

                                <td>
                                    @material.MasterCourseData?.MasterCourseName
                                </td>

                                <td>
                                    @material.SubCourseData?.SubCourseName
                                </td>

                                <td>
                                    @material.TopicData?.TopicName
                                </td>

                                <!-- ASSIGNMENT -->

                                <td>

                                    @if (!string.IsNullOrEmpty(
                                        material.AssignmentAttachment))
                                    {
                                        <a href="~/uploads/assignments/@material.AssignmentAttachment"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">

                                            View Assignment

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No File
                                        </span>
                                    }

                                </td>


                                <!-- MCQ -->

                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <span class="badge bg-info text-dark">
                                            3 Questions
                                        </span>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#viewMcqModal"
                                                onclick="showMCQ(@material.MaterialId)">

                                            View

                                        </button>

                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (material.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- CREATED -->

                                <td>
                                    @material.CreatedAt.ToString(
                                        "dd-MM-yyyy HH:mm")
                                </td>

                                <td>
                                    @material.CreatedBy
                                </td>


                                <!-- ACTION -->

                                <td>

                                    <div class="action-buttons">

                                        <a asp-controller="AddMaterial"
                                           asp-action="EditMaterial"
                                           asp-route-id="@material.MaterialId"
                                           class="btn btn-sm btn-warning">

                                            Edit

                                        </a>

                                        <form asp-controller="AddMaterial"
                                              asp-action="DeleteMaterial"
                                              asp-route-id="@material.MaterialId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this material?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD / EDIT MODAL
     ========================================================= -->

<div class="modal fade"
     id="materialModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="materialModalTitle">

                    @(isEdit
                        ? "Edit Material"
                        : "Add Material for Learning Platform")

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- FORM -->

            <form id="materialForm"
                  action="@(isEdit
                                    ? Url.Action("EditMaterial", "AddMaterial")
                                : Url.Action("AddMaterial", "AddMaterial"))"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                @if (isEdit)
                {
                    <input type="hidden"
                           id="editMaterialId"
                           name="id"
                           value="@editMaterial!.MaterialId" />
                }


                <!-- SCROLLABLE BODY -->

                <div class="material-modal-body">

                    <!-- =================================================
                         COURSE DETAILS
                         ================================================= -->

                    <div class="form-section">

                        <div class="section-title">
                            Course Details
                        </div>

                        <div class="row">

                            <!-- MASTER -->

                            <div class="col-md-4 mb-3">

                                <label class="form-label fw-semibold">
                                    Master Course
                                    <span class="text-danger">*</span>
                                </label>

                                <select name="MasterCourseId"
                                        id="MasterCourseId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Master Course
                                    </option>

                                    @foreach (var course in ViewBag.MasterCourses)
                                    {
                                        if (isEdit &&
                                            editMaterial!.MasterCourseId == course.Id)
                                        {
                                            <option value="@course.Id"
                                                    selected>

                                                @course.MasterCourseName

                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@course.Id">

                                                @course.MasterCourseName

                                            </option>
                                        }
                                    }

                                </select>

                            </div>


                            <!-- SUB COURSE -->

                            <div class="col-md-4 mb-3">

                                <label class="form-label fw-semibold">
                                    Sub Course
                                    <span class="text-danger">*</span>
                                </label>

                                <select name="SubCourseId"
                                        id="SubCourseId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Sub Course
                                    </option>

                                    @foreach (var course in ViewBag.SubCourses)
                                    {
                                        if (isEdit &&
                                            editMaterial!.SubCourseId == course.Id)
                                        {
                                            <option value="@course.Id"
                                                    data-master="@course.MasterCourseId"
                                                    selected>

                                                @course.SubCourseName

                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@course.Id"
                                                    data-master="@course.MasterCourseId">

                                                @course.SubCourseName

                                            </option>
                                        }
                                    }

                                </select>

                            </div>


                            <!-- TOPIC -->

                            <div class="col-md-4 mb-3">

                                <label class="form-label fw-semibold">
                                    Topic Name
                                    <span class="text-danger">*</span>
                                </label>

                                <select name="TopicId"
                                        id="TopicId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Topic
                                    </option>

                                    @foreach (var topic in ViewBag.Topics)
                                    {
                                        if (isEdit &&
                                            editMaterial!.TopicId == topic.Id)
                                        {
                                            <option value="@topic.Id"
                                                    data-master="@topic.MasterCourseId"
                                                    data-sub="@topic.SubCourseId"
                                                    selected>

                                                @topic.TopicName

                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@topic.Id"
                                                    data-master="@topic.MasterCourseId"
                                                    data-sub="@topic.SubCourseId">

                                                @topic.TopicName

                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ASSIGNMENT
                         ================================================= -->

                    <div class="form-section">

                        <div class="section-title">
                            Assignment
                        </div>

                        @if (isEdit &&
                             !string.IsNullOrEmpty(
                                 editMaterial!.AssignmentAttachment))
                        {
                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Current Assignment
                                </label>

                                <br />

                                <a href="~/uploads/assignments/@editMaterial.AssignmentAttachment"
                                   target="_blank"
                                   class="btn btn-outline-primary">

                                    View Current Assignment

                                </a>

                            </div>
                        }

                        <label class="form-label fw-semibold">

                            @(isEdit
                                ? "Replace Assignment"
                                : "Assignment")

                        </label>

                        <input type="file"
                               name="AssignmentFile"
                               class="form-control" />

                        <small class="text-muted">

                            @(isEdit
                                ? "Leave empty if you want to keep the existing assignment."
                                : "Upload the assignment file.")

                        </small>

                    </div>


                    <!-- =================================================
                         STATUS
                         ================================================= -->

                    <div class="form-section status-section">

                        <div class="section-title">
                            Material Status
                        </div>

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="Status"
                                id="Status"
                                class="form-select">

                            @if (isEdit &&
                                 editMaterial!.Status == "Inactive")
                            {
                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive"
                                        selected>
                                    Inactive
                                </option>
                            }
                            else
                            {
                                <option value="Active"
                                        selected>
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>
                            }

                        </select>

                    </div>


                    <!-- =================================================
                         MCQ
                         ================================================= -->

                    <div class="form-section">

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div class="section-title mb-0">
                                MCQ
                            </div>

                            <span class="badge bg-primary fs-6">
                                3 Questions
                            </span>

                        </div>


                        <!-- =================================================
                             QUESTION 1
                             ================================================= -->

                        <div class="mcq-card">

                            <div class="mcq-header">
                                Question 1
                            </div>

                            <div class="mcq-body">

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Question 1
                                    </label>

                                    <input type="text"
                                           name="MCQ1Question"
                                           class="form-control"
                                           value="@(isEdit ? editMaterial!.MCQ1Question : "")"
                                           placeholder="Enter Question 1"
                                           required />

                                </div>

                                <div class="row">

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option A
                                        </label>

                                        <input type="text"
                                               name="MCQ1OptionA"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ1OptionA : "")"
                                               placeholder="Enter Option A"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option B
                                        </label>

                                        <input type="text"
                                               name="MCQ1OptionB"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ1OptionB : "")"
                                               placeholder="Enter Option B"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option C
                                        </label>

                                        <input type="text"
                                               name="MCQ1OptionC"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ1OptionC : "")"
                                               placeholder="Enter Option C"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option D
                                        </label>

                                        <input type="text"
                                               name="MCQ1OptionD"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ1OptionD : "")"
                                               placeholder="Enter Option D"
                                               required />

                                    </div>

                                </div>

                                <label class="form-label fw-semibold">
                                    Correct Answer
                                </label>

                                <select name="MCQ1Answer"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Correct Answer
                                    </option>

                                    <option value="A"
                                            selected="@(isEdit && editMaterial!.MCQ1Answer == "A")">
                                        Option A
                                    </option>

                                    <option value="B"
                                            selected="@(isEdit && editMaterial!.MCQ1Answer == "B")">
                                        Option B
                                    </option>

                                    <option value="C"
                                            selected="@(isEdit && editMaterial!.MCQ1Answer == "C")">
                                        Option C
                                    </option>

                                    <option value="D"
                                            selected="@(isEdit && editMaterial!.MCQ1Answer == "D")">
                                        Option D
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- =================================================
                             QUESTION 2
                             ================================================= -->

                        <div class="mcq-card">

                            <div class="mcq-header">
                                Question 2
                            </div>

                            <div class="mcq-body">

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Question 2
                                    </label>

                                    <input type="text"
                                           name="MCQ2Question"
                                           class="form-control"
                                           value="@(isEdit ? editMaterial!.MCQ2Question : "")"
                                           placeholder="Enter Question 2"
                                           required />

                                </div>

                                <div class="row">

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option A
                                        </label>

                                        <input type="text"
                                               name="MCQ2OptionA"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ2OptionA : "")"
                                               placeholder="Enter Option A"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option B
                                        </label>

                                        <input type="text"
                                               name="MCQ2OptionB"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ2OptionB : "")"
                                               placeholder="Enter Option B"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option C
                                        </label>

                                        <input type="text"
                                               name="MCQ2OptionC"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ2OptionC : "")"
                                               placeholder="Enter Option C"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option D
                                        </label>

                                        <input type="text"
                                               name="MCQ2OptionD"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ2OptionD : "")"
                                               placeholder="Enter Option D"
                                               required />

                                    </div>

                                </div>

                                <label class="form-label fw-semibold">
                                    Correct Answer
                                </label>

                                <select name="MCQ2Answer"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Correct Answer
                                    </option>

                                    <option value="A"
                                            selected="@(isEdit && editMaterial!.MCQ2Answer == "A")">
                                        Option A
                                    </option>

                                    <option value="B"
                                            selected="@(isEdit && editMaterial!.MCQ2Answer == "B")">
                                        Option B
                                    </option>

                                    <option value="C"
                                            selected="@(isEdit && editMaterial!.MCQ2Answer == "C")">
                                        Option C
                                    </option>

                                    <option value="D"
                                            selected="@(isEdit && editMaterial!.MCQ2Answer == "D")">
                                        Option D
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- =================================================
                             QUESTION 3
                             ================================================= -->

                        <div class="mcq-card">

                            <div class="mcq-header">
                                Question 3
                            </div>

                            <div class="mcq-body">

                                <div class="mb-3">

                                    <label class="form-label fw-semibold">
                                        Question 3
                                    </label>

                                    <input type="text"
                                           name="MCQ3Question"
                                           class="form-control"
                                           value="@(isEdit ? editMaterial!.MCQ3Question : "")"
                                           placeholder="Enter Question 3"
                                           required />

                                </div>

                                <div class="row">

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option A
                                        </label>

                                        <input type="text"
                                               name="MCQ3OptionA"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ3OptionA : "")"
                                               placeholder="Enter Option A"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option B
                                        </label>

                                        <input type="text"
                                               name="MCQ3OptionB"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ3OptionB : "")"
                                               placeholder="Enter Option B"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option C
                                        </label>

                                        <input type="text"
                                               name="MCQ3OptionC"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ3OptionC : "")"
                                               placeholder="Enter Option C"
                                               required />

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Option D
                                        </label>

                                        <input type="text"
                                               name="MCQ3OptionD"
                                               class="form-control"
                                               value="@(isEdit ? editMaterial!.MCQ3OptionD : "")"
                                               placeholder="Enter Option D"
                                               required />

                                    </div>

                                </div>

                                <label class="form-label fw-semibold">
                                    Correct Answer
                                </label>

                                <select name="MCQ3Answer"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Correct Answer
                                    </option>

                                    <option value="A"
                                            selected="@(isEdit && editMaterial!.MCQ3Answer == "A")">
                                        Option A
                                    </option>

                                    <option value="B"
                                            selected="@(isEdit && editMaterial!.MCQ3Answer == "B")">
                                        Option B
                                    </option>

                                    <option value="C"
                                            selected="@(isEdit && editMaterial!.MCQ3Answer == "C")">
                                        Option C
                                    </option>

                                    <option value="D"
                                            selected="@(isEdit && editMaterial!.MCQ3Answer == "D")">
                                        Option D
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            id="materialSubmitButton"
                            class="btn btn-primary">

                        @(isEdit
                            ? "Update Material"
                            : "Add Material")

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     VIEW MCQ MODAL
     ========================================================= -->

<div class="modal fade"
     id="viewMcqModal"
     tabindex="-1"
     aria-hidden="true">

