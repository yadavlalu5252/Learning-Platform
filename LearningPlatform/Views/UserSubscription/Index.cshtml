@model IEnumerable<LearningPlatform.Models.Subscription>
@{
    ViewData["Title"] = "Subscriptions";
}

<div class="container py-5">
    <h2 class="text-center mb-4">Choose Your Subscription</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@item.Thumbnail" class="card-img-top"
                         style="height:180px;object-fit:cover" alt="Course">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@item.stype</span>
                        <h4>@item.MasterCourseData?.MasterCourseName</h4>
                        <p class="mb-1"><strong>Course:</strong> @item.SubCourseData?.SubCourseName</p>
                        <p><strong>Validity:</strong> @item.Validity days</p>
                        <h3>₹ @item.amount</h3>
                        <a asp-action="Details" asp-route-id="@item.sid"
                           class="btn btn-primary w-100 mt-2">View & Buy</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
