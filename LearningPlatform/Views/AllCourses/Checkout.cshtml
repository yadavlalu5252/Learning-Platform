@model List<LearningPlatform.Models.Cart>

@{
    ViewData["Title"] = "Checkout";

    decimal total = 0;
}

<div class="container mt-4">

    <h2 class="mb-4">
        Checkout
    </h2>

    @foreach (var item in Model)
    {
        string name = "";
        string type = "";

        if (item.MasterCourseData != null)
        {
            name = item.MasterCourseData.MasterCourseName;
            type = "Master Course";
        }
        else if (item.SubCourseData != null)
        {
            name = item.SubCourseData.SubCourseName;
            type = "Sub Course";
        }
        else if (item.SubscriptionData != null)
        {
            name = item.SubscriptionData.stype;
            type = "Subscription";
        }

        total += item.Amount;

        <div class="card shadow-sm mb-3">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h5 class="mb-1">
                            @name
                        </h5>

                        <small class="text-muted">
                            @type
                        </small>
                    </div>

                    <strong>
                        ₹@item.Amount
                    </strong>

                </div>

            </div>

        </div>
    }

    <div class="card shadow mt-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <h4 class="mb-0">
                    Total Amount
                </h4>

                <h4 class="mb-0">
                    ₹@total
                </h4>

            </div>

        </div>

    </div>

    <div class="d-flex justify-content-between mt-4">

        <a asp-controller="AllCourses"
           asp-action="Cart"
           class="btn btn-secondary">
            Back to Cart
        </a>

        <form asp-controller="AllCourses"
              asp-action="ConfirmPurchase"
              method="post">

            <button type="submit"
                    class="btn btn-success btn-lg">
                Confirm Purchase
            </button>

        </form>

    </div>

</div>