@model List<LearningPlatform.Models.Cart>

@{
    ViewData["Title"] = "My Cart";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>🛒 My Cart</h2>

        <a asp-controller="AllCourses"
           asp-action="Index"
           class="btn btn-secondary">
            Continue Shopping
        </a>

    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        decimal total = 0;

        foreach (var item in Model)
        {
            string name = "";
            string type = "";

            if (item.MasterCourseData != null)
            {
                name = item.MasterCourseData.MasterCourseName;
                type = "Master Course";
            }
            else if (item.SubCourseData != null)
            {
                name = item.SubCourseData.SubCourseName;
                type = "Sub Course";
            }
            else if (item.SubscriptionData != null)
            {
                name = item.SubscriptionData.stype;
                type = "Subscription";
            }

            total += item.Amount;

            <div class="card shadow-sm mb-3">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="mb-1">
                                @name
                            </h5>

                            <small class="text-muted">
                                @type
                            </small>

                        </div>

                        <div class="text-end">

                            <strong class="d-block mb-2">
                                ₹@item.Amount
                            </strong>

                            <form asp-controller="AllCourses"
                                  asp-action="RemoveFromCart"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@item.CartId" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Remove
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="card shadow mt-4">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <h4 class="mb-0">
                        Total
                    </h4>

                    <h4 class="mb-0">
                        ₹@total
                    </h4>

                </div>

            </div>

        </div>
        <div class="text-end mt-3">

            <a asp-controller="AllCourses"
               asp-action="Checkout"
               class="btn btn-success btn-lg">
                Proceed to Checkout
            </a>

        </div>
    }

</div>