@model List<LearningPlatform.Models.AddTopic>

@{
    ViewData["Title"] = "Topic List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css" />

<style>

    body {
        background-color: #f8f9fa;
    }

    .topic-container {
        max-width: 1300px;
        margin: 40px auto;
    }

    .page-title {
        font-weight: 700;
        color: #212529;
    }

    .table-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .topic-table th {
        background-color: #212529;
        color: white;
        vertical-align: middle;
    }

    .topic-table td {
        vertical-align: middle;
    }

    .thumbnail {
        width: 90px;
        height: 65px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .status-active {
        background-color: #198754;
        color: white;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 13px;
    }

    .status-inactive {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 13px;
    }

    .action-btn {
        width: 70px;
        margin-bottom: 5px;
    }

</style>


<div class="container topic-container">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="page-title">
            Topic List
        </h2>

        <a asp-controller="AddTopic"
           asp-action="AddTopic"
           class="btn btn-primary">

            + Add Topic

        </a>

    </div>


    <!-- TABLE -->

    <div class="table-card">

        <div class="table-responsive">

            <table id="topicTable"
                   class="table table-bordered table-striped topic-table w-100">

                <thead>

                    <tr>

                        <th>Id</th>

                        <th>Master Course</th>

                        <th>Sub Course</th>

                        <th>Topic Name</th>

                        <th>Video URL</th>

                        <th>Status</th>

                        <th>Thumbnail</th>

                        <th>Created At</th>

                        <th>Created By</th>

                        <th>Action</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var topic in Model)
                    {
                        <tr>

                            <td>
                                @topic.Id
                            </td>


                            <td>
                                @topic.MasterCourseData?.MasterCourseName
                            </td>


                            <td>
                                @topic.SubCourseData?.SubCourseName
                            </td>


                            <td>
                                @topic.TopicName
                            </td>


                            <td>

                                @if (!string.IsNullOrEmpty(topic.VideoUrl))
                                {
                                    <a href="@topic.VideoUrl"
                                       target="_blank"
                                       class="btn btn-outline-primary btn-sm">

                                        View<br />Video

                                    </a>
                                }
                                else
                                {
                                    <span>
                                        No Video
                                    </span>
                                }

                            </td>


                            <td>

                                @if (topic.Status == "Active")
                                {
                                    <span class="status-active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td>

                                @if (!string.IsNullOrEmpty(topic.Thumbnail))
                                {
                                    <img src="~/uploads/topics/@topic.Thumbnail"
                                         class="thumbnail" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Image
                                    </span>
                                }

                            </td>


                            <td>
                                @topic.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                            </td>


                            <td>
                                @topic.CreatedBy
                            </td>


                            <td>

                                <a asp-controller="AddTopic"
                                   asp-action="EditTopic"
                                   asp-route-id="@topic.Id"
                                   class="btn btn-warning btn-sm action-btn">

                                    Edit

                                </a>


                                <form asp-controller="AddTopic"
                                      asp-action="DeleteTopic"
                                      asp-route-id="@topic.Id"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm action-btn"
                                            onclick="return confirm('Are you sure you want to delete this topic?');">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>

<script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"></script>


<script>

    $(document).ready(function() {

        $('#topicTable').DataTable({

            pageLength: 5,

            lengthMenu: [5, 10, 25, 50],

            paging: true,

            searching: true,

            ordering: true,

            info: true

        });

    });

</script>