@model LearningPlatform.Models.AddTopic

@{
    ViewData["Title"] = "Add Topic";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>

    body {
        background-color: #f8f9fa;
    }

    .add-topic-container {
        max-width: 900px;
        margin: 40px auto;
    }

    .page-title {
        font-weight: 700;
        color: #212529;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 25px;
        color: #212529;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control,
    .form-select {
        min-height: 45px;
    }

    .required {
        color: red;
    }

</style>


<div class="container add-topic-container">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="page-title">
            Add Topic
        </h2>

        <a asp-controller="AddTopic"
           asp-action="Index"
           class="btn btn-secondary">

            Back

        </a>

    </div>


    <!-- =====================================================
         FORM
         ===================================================== -->

    <div class="form-card">

        <form asp-controller="AddTopic"
              asp-action="AddTopic"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- =================================================
                 MASTER COURSE
                 ================================================= -->

            <div class="mb-4">

                <label asp-for="MasterCourseId"
                       class="form-label">

                    Master Course
                    <span class="required">*</span>

                </label>


                <select asp-for="MasterCourseId"
                        class="form-select"
                        required>

                    <option value="">
                        Select Master Course
                    </option>


                    @if (ViewBag.MasterCourses != null)
                    {
                        foreach (var course in ViewBag.MasterCourses)
                        {
                            <option value="@course.Id">

                                @course.MasterCourseName

                            </option>
                        }
                    }

                </select>


                <span asp-validation-for="MasterCourseId"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 SUB COURSE
                 ================================================= -->

            <div class="mb-4">

                <label asp-for="SubCourseId"
                       class="form-label">

                    Sub Course
                    <span class="required">*</span>

                </label>


                <select asp-for="SubCourseId"
                        class="form-select"
                        required>

                    <option value="">
                        Select Sub Course
                    </option>


                    @if (ViewBag.SubCourses != null)
                    {
                        foreach (var course in ViewBag.SubCourses)
                        {
                            <option value="@course.Id">

                                @course.SubCourseName

                            </option>
                        }
                    }

                </select>


                <span asp-validation-for="SubCourseId"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 TOPIC NAME
                 ================================================= -->

            <div class="mb-4">

                <label asp-for="TopicName"
                       class="form-label">

                    Topic Name
                    <span class="required">*</span>

                </label>


                <input asp-for="TopicName"
                       class="form-control"
                       placeholder="Enter topic name"
                       required />


                <span asp-validation-for="TopicName"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 VIDEO URL
                 ================================================= -->

            <div class="mb-4">

                <label asp-for="VideoUrl"
                       class="form-label">

                    Video URL
                    <span class="required">*</span>

                </label>


                <input asp-for="VideoUrl"
                       class="form-control"
                       placeholder="Enter video URL"
                       required />


                <span asp-validation-for="VideoUrl"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 STATUS
                 ================================================= -->

            <div class="mb-4">

                <label asp-for="Status"
                       class="form-label">

                    Status
                    <span class="required">*</span>

                </label>


                <select asp-for="Status"
                        class="form-select"
                        required>

                    <option value="Active">
                        Active
                    </option>

                    <option value="Inactive">
                        Inactive
                    </option>

                </select>


                <span asp-validation-for="Status"
                      class="text-danger">
                </span>

            </div>


            <!-- =================================================
                 THUMBNAIL
                 ================================================= -->

            <div class="mb-4">

                <label class="form-label">

                    Thumbnail

                </label>


                <input type="file"
                       name="ThumbnailFile"
                       class="form-control"
                       accept="image/*" />


                <div class="form-text">

                    Upload a thumbnail image for the topic.

                </div>

            </div>


            <!-- =================================================
                 BUTTONS
                 ================================================= -->

            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    Add Topic

                </button>


                <a asp-controller="AddTopic"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
</script>