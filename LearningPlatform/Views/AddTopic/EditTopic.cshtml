@model LearningPlatform.Models.AddTopic

@{
    ViewData["Title"] = "Edit Topic";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Edit Topic
        </h2>

        <a asp-controller="AddTopic"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="AddTopic"
                  asp-action="EditTopic"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <!-- MASTER COURSE -->

                <div class="mb-3">

                    <label class="form-label">
                        Master Course
                    </label>

                    <select asp-for="MasterCourseId"
                            class="form-select"
                            required>

                        <option value="">
                            Select Master Course
                        </option>

                        @foreach (var course in ViewBag.MasterCourses)
                        {
                            <option value="@course.Id">
                                @course.MasterCourseName
                            </option>
                        }

                    </select>

                </div>


                <!-- SUB COURSE -->

                <div class="mb-3">

                    <label class="form-label">
                        Sub Course
                    </label>

                    <select asp-for="SubCourseId"
                            class="form-select"
                            required>

                        <option value="">
                            Select Sub Course
                        </option>

                        @foreach (var course in ViewBag.SubCourses)
                        {
                            <option value="@course.Id">
                                @course.SubCourseName
                            </option>
                        }

                    </select>

                </div>


                <!-- TOPIC NAME -->

                <div class="mb-3">

                    <label class="form-label">
                        Topic Name
                    </label>

                    <input asp-for="TopicName"
                           class="form-control"
                           placeholder="Enter topic name"
                           required />

                </div>


                <!-- VIDEO URL -->

                <div class="mb-3">

                    <label class="form-label">
                        Video URL
                    </label>

                    <input asp-for="VideoUrl"
                           class="form-control"
                           placeholder="Enter video URL"
                           required />

                </div>


                <!-- STATUS -->

                <div class="mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select"
                            required>

                        <option value="Active">
                            Active
                        </option>

                        <option value="Inactive">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- CURRENT THUMBNAIL -->

                <div class="mb-3">

                    <label class="form-label">
                        Current Thumbnail
                    </label>

                    <br />

                    @if (!string.IsNullOrEmpty(Model.Thumbnail))
                    {
                        <img src="~/uploads/topics/@Model.Thumbnail"
                             width="100"
                             height="70"
                             style="object-fit:cover;"
                             class="rounded border" />
                    }
                    else
                    {
                        <span>
                            No thumbnail
                        </span>
                    }

                </div>


                <!-- CHANGE THUMBNAIL -->

                <div class="mb-4">

                    <label class="form-label">
                        Change Thumbnail
                    </label>

                    <input type="file"
                           name="ThumbnailFile"
                           class="form-control" />

                </div>


                <!-- BUTTONS -->

                <button type="submit"
                        class="btn btn-primary">

                    Update Topic

                </button>


                <a asp-controller="AddTopic"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>