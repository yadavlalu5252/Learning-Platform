@model LearningPlatform.Models.SubCourse

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
@{
    ViewData["Title"] = "Learning";

    var topics = ViewBag.Topics as List<LearningPlatform.Models.AddTopic>;
    var currentTopic = ViewBag.CurrentTopic as LearningPlatform.Models.AddTopic;
    var material = ViewBag.Material as LearningPlatform.Models.AddMaterial;
    var unlockedTopicId = ViewBag.UnlockedTopicId;
}

<div class="container-fluid mt-4">

    <div class="mb-4">
        <h2>@Model.SubCourseName</h2>

        <span class="badge bg-success">
            @Model.Status
        </span>
    </div>

    <div class="row">

        <!-- LEFT SIDE -->

        <div class="col-lg-8">

            <!-- VIDEO -->

            <div class="card shadow mb-4">

                <div class="card-body">

                    <h5 class="mb-3">
                        @currentTopic?.TopicName
                    </h5>

                    <div class="ratio ratio-16x9">

                        <iframe src="@currentTopic?.VideoUrl"
                                title="@currentTopic?.TopicName"
                                allowfullscreen>
                        </iframe>

                    </div>

                </div>

            </div>


            <!-- ASSIGNMENT -->

            <div class="card shadow mb-4">

                <div class="card-body">

                    <h4 class="mb-3">
                        Assignment
                    </h4>

                    @if (material != null && !string.IsNullOrEmpty(material.AssignmentAttachment))
                    {
                        <a asp-controller="MyCourses"
                           asp-action="DownloadAssignment"
                           asp-route-id="@material.MaterialId"
                           class="btn btn-primary mb-3">
                            Download Assignment
                        </a>

                        <form asp-controller="MyCourses"
                              asp-action="UploadSolution"
                              method="post"
                              enctype="multipart/form-data">

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <input type="hidden"
                                   name="topicId"
                                   value="@currentTopic.Id" />

                            <input type="hidden"
                                   name="materialId"
                                   value="@material.MaterialId" />

                            <input type="file"
                                   name="solutionFile"
                                   class="form-control"
                                   accept=".pdf,.doc,.docx"
                                   required />

                            <button type="submit"
                                    class="btn btn-success">
                                Upload Solution
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No assignment available for this topic.
                        </div>
                    }

                </div>

            </div>


            <!-- MCQ -->
            <!-- MCQ -->

            <div class="card shadow mb-4">

                <div class="card-body">

                    <h4 class="mb-4">
                        MCQ
                    </h4>

                    @if (material != null)
                    {
                        <form asp-controller="MyCourses"
                              asp-action="SubmitMcq"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <input type="hidden"
                                   name="topicId"
                                   value="@currentTopic.Id" />


                            <!-- MCQ 1 -->

                            <div class="mb-4">

                                <h6>
                                    1. @material.MCQ1Question
                                </h6>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq1"
                                           value="A">

                                    <label class="form-check-label">
                                        A. @material.MCQ1OptionA
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq1"
                                           value="B">

                                    <label class="form-check-label">
                                        B. @material.MCQ1OptionB
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq1"
                                           value="C">

                                    <label class="form-check-label">
                                        C. @material.MCQ1OptionC
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq1"
                                           value="D">

                                    <label class="form-check-label">
                                        D. @material.MCQ1OptionD
                                    </label>
                                </div>

                            </div>


                            <!-- MCQ 2 -->

                            <div class="mb-4">

                                <h6>
                                    2. @material.MCQ2Question
                                </h6>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq2"
                                           value="A">

                                    <label class="form-check-label">
                                        A. @material.MCQ2OptionA
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq2"
                                           value="B">

                                    <label class="form-check-label">
                                        B. @material.MCQ2OptionB
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq2"
                                           value="C">

                                    <label class="form-check-label">
                                        C. @material.MCQ2OptionC
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq2"
                                           value="D">

                                    <label class="form-check-label">
                                        D. @material.MCQ2OptionD
                                    </label>
                                </div>

                            </div>


                            <!-- MCQ 3 -->

                            <div class="mb-4">

                                <h6>
                                    3. @material.MCQ3Question
                                </h6>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq3"
                                           value="A">

                                    <label class="form-check-label">
                                        A. @material.MCQ3OptionA
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq3"
                                           value="B">

                                    <label class="form-check-label">
                                        B. @material.MCQ3OptionB
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq3"
                                           value="C">

                                    <label class="form-check-label">
                                        C. @material.MCQ3OptionC
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="mcq3"
                                           value="D">

                                    <label class="form-check-label">
                                        D. @material.MCQ3OptionD
                                    </label>
                                </div>

                            </div>


                            <form asp-controller="MyCourses"
                                  asp-action="SubmitMcq"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@Model.Id" />

                                <input type="hidden"
                                       name="topicId"
                                       value="@currentTopic.Id" />

                                <!-- your 3 MCQs -->

                                <button type="submit"
                                        class="btn btn-primary">
                                    Submit MCQ
                                </button>

                            </form>

                        </form>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No MCQ available for this topic.
                        </div>
                    }

                </div>

            </div>
            @if (TempData["CourseCompleted"] != null)
            {
                <div class="card shadow mt-4 border-success">
                    <div class="card-body text-center">
                        <h4 class="text-success">🎉 Course Completed!</h4>
                        <p class="mb-3">
                            Congratulations! You have successfully completed this course.
                        </p>

                        <a asp-controller="MyCourses"
                           asp-action="GenerateCertificate"
                           asp-route-subCourseId="@Model.Id"
                           class="btn btn-success btn-lg">
                            🏆 Download Certificate
                        </a>
                    </div>
                </div>
            }
        </div>


        <!-- RIGHT SIDE -->

        <div class="col-lg-4">

            <div class="card shadow">

                <div class="card-body">

                    <h4 class="mb-3">
                        Topics
                    </h4>

                    @foreach (var topic in topics)
                    {
                        var topicProgress = ((List<LearningPlatform.Models.CourseProgress>)ViewBag.Progress)
                            .FirstOrDefault(x => x.TopicId == topic.Id);

                        var topicIndex = topics.IndexOf(topic);
                        var unlockedIndex = topics.FindIndex(x => x.Id == unlockedTopicId);

                        var isCompleted = topicProgress != null && topicProgress.McqCompleted;
                        var isUnlocked = topicIndex <= unlockedIndex;

                        <div class="d-flex justify-content-between align-items-center border-bottom p-3">

                            <span>
                                @topic.TopicName
                            </span>

                            @if (isCompleted)
                            {
                                <a asp-controller="MyCourses"
                                   asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   asp-route-topicId="@topic.Id"
                                   class="btn btn-sm btn-success">
                                    ✓
                                </a>
                            }
                            else if (isUnlocked)
                            {
                                <a asp-controller="MyCourses"
                                   asp-action="Learn"
                                   asp-route-id="@Model.Id"
                                   asp-route-topicId="@topic.Id"
                                   class="btn btn-sm btn-primary">
                                    ▶
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary">
                                    🔒
                                </span>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>